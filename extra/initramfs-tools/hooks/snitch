#!/bin/sh
# initramfs-tools hook: put snitch-ebpf-load into the initramfs. Install to
# /etc/initramfs-tools/hooks/snitch, with scripts/init-bottom/snitch, then
# update-initramfs -u.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions
copy_exec /usr/sbin/snitch-ebpf-load /usr/sbin
